normal1: body,f1,after
normal2: body,f1,f2,after
normal3: body,f1,f2,f3,after
return1: r1:body,f1
return2: r2:body,f1,f2
return3: r3:body,f1,f2,f3
throw1: e1:body,f1
throw2: e2:body,f1,f2
throw3: e3:body,f1,f2,f3
bc3: top:0,bot:0,f1:0,f2:0,f3:0,end:0,top:1,f1:1,f2:1,f3:1,top:2,f1:2,f2:2,f3:2,done
partial: body:0,inner_fin:0,inner_fin:1,body:2,inner_fin:2,outer_fin
switchFin: c0,f0,after_sw:0,c1,f1,c2:ret2
nestedOverride: try:0,outer_fin_start:0,inner_fin:0,try:1,outer_fin_start:1,inner_fin:1
